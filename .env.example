# ============================================================
#  Solana Small-Cap Trading Bot — Variables d'environnement
#  Copier ce fichier en `.env` et remplir les valeurs.
# ============================================================

# --- Clés API (optionnelles mais recommandées) ---
# Birdeye : https://docs.birdeye.so/  (header x-api-key)
BIRDEYE_API_KEY=

# RPC Solana (Helius, QuickNode, ou public). Utilisé seulement en mode LIVE.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Wallet (UNIQUEMENT pour le mode LIVE — laisser vide en paper) ---
# Clé privée base58 du wallet d'exécution. NE JAMAIS COMMIT.
WALLET_PRIVATE_KEY=

# --- Notifications (optionnel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
